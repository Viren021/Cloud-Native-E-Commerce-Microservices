# gitignore generated for ecommerce-microservices project
# Compiled class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# Help markdown
HELP.md

# Maven target directories (exclude wrapper JAR, keep build outputs for modules)
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Spring Tool Suite (STS) files
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# IntelliJ IDEA files
.idea
*.iws
*.iml
*.ipr

# NetBeans files
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# VS Code files
.vscode/

# macOS system files
.DS_Store
files

# Agent artefacts (Claude, Codex, etc.)
.claude
.codegraph
.codex
.github/prompts
.venv

# Flatten-maven-plugin artefacts
**/.flattened-pom.xml
.flattened-pom.xml

# Environment configuration (keep secret values out of repo)
.env
